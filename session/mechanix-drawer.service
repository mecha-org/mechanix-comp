[Unit]
Description=Mechanix app drawer (nwg-drawer, temporary)
BindsTo=mechanix-compositor.service
After=mechanix-compositor.service
PartOf=graphical-session.target
ConditionPathExists=/usr/bin/nwg-drawer

[Service]
# A drawer that died uncleanly leaves its lock behind and refuses to start.
ExecStartPre=-/usr/bin/rm -f %h/.local/share/nwg-drawer.lock
ExecStart=/usr/bin/nwg-drawer -r -k -nocats -nofs -c 3 -is 48 -spacing 12
Restart=on-failure
RestartSec=1
Slice=session.slice
